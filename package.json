{
  "name": "gestor-planilla-patty",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm db:check && next dev",
    "build": "next build",
    "start": "pnpm db:check && next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/probar-en-navegador.ts",
    "test:watch": "vitest",
    "validate": "tsx scripts/validar-con-base.ts",
    "revisar": "tsx scripts/revisar-rama.ts",
    "revisar:limpiar": "tsx scripts/revisar-rama.ts limpiar",
    "sembrar-base": "tsx scripts/sembrar-base.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrar-base.ts migrate",
    "db:check": "tsx scripts/migrar-base.ts check",
    "db:baseline": "tsx scripts/migrar-base.ts baseline",
    "provisionar:administracion": "tsx scripts/provisionar-administracion.ts",
    "provisionar:cuenta": "tsx scripts/provisionar-cuenta.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.44.7",
    "next": "^15.5.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "onlyBuiltDependencies": [
    "esbuild"
  ],
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
